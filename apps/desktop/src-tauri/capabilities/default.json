{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core defaults (incl. event listening) plus the app commands the pages call.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-hide-to-tray",
    "allow-list-devices",
    "allow-set-direct",
    "allow-set-zone",
    "allow-set-mode",
    "allow-resize-zone",
    "allow-save-to-hardware",
    "allow-release-device",
    "allow-release-all",
    "allow-rescan",
    "allow-list-profiles",
    "allow-save-profile",
    "allow-apply-profile",
    "allow-rename-profile",
    "allow-delete-profile",
    "allow-scan-conflicts",
    "allow-terminate-process",
    "allow-stop-service",
    "allow-get-settings",
    "allow-set-settings"
  ]
}
